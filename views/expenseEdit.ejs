<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>지출입력</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/main.css" rel="stylesheet">
    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link href="/main.css" rel="stylesheet">

    <!-- Flatpickr JS -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ko.js"></script>
</head>

<body>
    <%- include('nav.ejs') %>

        <div class="container mt-5" style="max-width: 600px;">
            <h2 class="mb-4 text-center">지출 내역 입력</h2>

            <form id="expenseForm" method="post" action="/expense/save">

                <!-- 💡 고정값: 지출(expense) 구분을 위한 hidden 필드 -->
                <input type="hidden" name="moneyType" value="expense">

                <!-- 1. 정기 고정비 등록 (isFixed) -->
                <div
                    class="mb-4 d-flex align-items-center justify-content-between p-3 rounded-3 bg-white shadow-sm border border-light">
                    <div>
                        <label class="form-check-label fw-bold text-dark d-block mb-1" for="isFixedExpense">
                            정기 고정비 등록
                        </label>
                        <small class="text-muted" style="font-size: 13px;">숨만 쉬어도 나가는 돈(월세, 보험료 등)인가요?</small>
                    </div>

                    <div class="form-check form-switch m-0 p-0 d-flex align-items-center">
                        <input class="form-check-input custom-switch" type="checkbox" role="switch" id="isFixedExpense"
                            name="isFixed" <%=(typeof result !=='undefined' && result.isFixed) ? 'checked' : '' %>>
                    </div>
                </div>

                <!-- 2. 그룹/이벤트 (event) -->
                <div class="input-group mb-3">
                    <label class="input-group-text" for="group">그룹/이벤트</label>
                    <select class="form-select" id="group" name="event">
                        <option disabled <%=(typeof result==='undefined' || !result.event) ? 'selected' : '' %>>선택하세요...
                        </option>
                        <% const events=['개인지출', '친구' , '데이트' , '지인' , '가족' , '비즈니스' , '기타이벤트' ]; const
                            selectedEvent=(typeof result !=='undefined' && result.event) ? result.event : '개인지출' ;
                            events.forEach(evt=> {
                            %>
                            <option value="<%= evt %>" <%=selectedEvent===evt ? 'selected' : '' %>>
                                <%= evt==='개인지출' ? '개인지출 (기본)' : (evt==='기타이벤트' ? '기타 이벤트' : evt) %>
                            </option>
                            <% }); %>
                    </select>
                </div>

                <!-- 3. 카테고리 (category) -->
                <div class="input-group mb-3">
                    <label class="input-group-text" for="category">카테고리</label>
                    <select class="form-select" id="category" name="category">
                        <option disabled <%=(typeof result==='undefined' || !result.category) ? 'selected' : '' %>
                            >선택하세요...</option>
                        <% const categories=['식비', '교통비' , '주거/통신' , '문화/여가' , '구독비' , '쇼핑비' , '병원비' , '기타' ]; const
                            selectedCategory=(typeof result !=='undefined' && result.category) ? result.category : '' ;
                            categories.forEach(cat=> {
                            %>
                            <option value="<%= cat %>" <%=selectedCategory===cat ? 'selected' : '' %>><%= cat %>
                            </option>
                            <% }); %>
                    </select>
                </div>

                <!-- 4. 지출액 (price) -->
                <div class="input-group mb-3">
                    <span class="input-group-text">지출액</span>
                    <input type="number" class="form-control" id="amount" name="price" placeholder="금액을 입력하세요"
                        value="<%= (typeof result !== 'undefined' && result.price) ? result.price : '' %>"
                        aria-label="Amount" required>
                    <span class="input-group-text">원</span>
                </div>

                <!-- 5. 날짜 (Flatpickr) -->
                <div class="input-group mb-3">
                    <span class="input-group-text" id="dateLabel">
                        <%= (typeof result !=='undefined' && result.isFixed) ? '시작 날짜' : '날짜' %>
                    </span>

                    <% let initialDate='' ; if (typeof result
                        !=='undefined' && result.year && result.month && result.day) { const y=result.year; const
                        m=String(result.month).padStart(2, '0' ); // 1 -> "01", 12 -> "12"
                        const d = String(result.day).padStart(2, '0'); // 7 -> "07", 25 -> "25"
                        initialDate = `${y}-${m}-${d}`;
                        }
                        %>

                        <input type="text" id="datePicker" name="date" class="form-control bg-white" placeholder="날짜 선택"
                            value="<%= initialDate %>" required>
                </div>

                <!-- 6. 설명 (explanation) -->
                <div class="input-group mb-4">
                    <span class="input-group-text">설명</span>
                    <input type="text" class="form-control" id="description" name="explanation"
                        placeholder="지출 관련 메모를 적어주세요"
                        value="<%= (typeof result !== 'undefined' && result.explanation) ? result.explanation : '' %>">
                </div>

                <!-- 7. 저장 버튼 -->
                <div class="d-grid gap-2">
                    <button class="btn btn-primary btn-lg" type="submit">지출 내역 저장하기</button>
                </div>

            </form>
        </div>



        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
        <script>
            const initialDateVal = document.getElementById('datePicker').value;

            // 2. Flatpickr 초기화
            const fp = flatpickr("#datePicker", {
                locale: "ko",
                dateFormat: "Y-m-d",
                // 💡 HTML input에 값이 설정되어 있으면 그 값을 쓰고, 아예 없으면 "today" 적용
                defaultDate: initialDateVal ? initialDateVal : "today"
            });

            const isFixedCheckbox = document.getElementById('isFixedExpense');
            const dateLabel = document.getElementById('dateLabel');

            // 라벨 토글
            if (isFixedCheckbox) {
                isFixedCheckbox.addEventListener('change', function () {
                    dateLabel.textContent = this.checked ? '시작 날짜' : '날짜';
                });
            }

            // 폼 제출 비동기 처리 (PUT JSON)
            document.getElementById('expenseForm').addEventListener('submit', async (e) => {
                e.preventDefault();

                const isFixed = !!(isFixedCheckbox && isFixedCheckbox.checked);

                // 💡 id를 'date'에서 'datePicker'로 수정했습니다.
                const payload = {
                    event: document.getElementById('group').value,
                    category: document.getElementById('category').value,
                    price: Number(document.getElementById('amount').value) || 0,
                    date: document.getElementById('datePicker').value,
                    isFixed: isFixed,
                    explanation: document.getElementById('description').value
                };

                // 날짜 유효성 검사
                if (!payload.date) {
                    alert('날짜를 선택해주세요.');
                    return;
                }

                try {
                    // 💡 result._id 가 없을 경우를 대비한 안전한 URL 처리
                    const editId = "<%= (typeof result !== 'undefined' && result._id) ? result._id : '' %>";
                    const targetUrl = editId ? `/expense/edit/${editId}` : '/expense/save';
                    const targetMethod = editId ? 'PUT' : 'POST';

                    const response = await fetch(targetUrl, {
                        method: targetMethod,
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });

                    const resJson = await response.json();

                    if (!response.ok || !resJson.success) {
                        const errors = resJson && resJson.errors ? Object.values(resJson.errors) : [];
                        if (errors.length > 0) alert(errors[0]);
                        else alert(resJson.message || '저장/수정에 실패했습니다.');
                        return;
                    }

                    alert('성공적으로 저장되었습니다.');
                    window.location.href = '/expense/list';
                } catch (err) {
                    console.error('서버 통신 에러:', err);
                    alert('서버와 연결할 수 없습니다.');
                }
            });
        </script>
</body>

</html>