<!DOCTYPE html>
<html lang="ko">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>지출입력</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Flatpickr CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link href="/main.css" rel="stylesheet">

    <!-- Flatpickr JS -->
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ko.js"></script>
</head>

<body>
    <%- include('nav.ejs') %>
    <%
        const initialDate = typeof result !== 'undefined' && result.date
            ? result.date
            : (typeof selectedDate !== 'undefined' ? selectedDate : '');
    %>

    <div class="container mt-5" style="max-width: 600px;">
        <h2 class="mb-4 text-center">
            <%= (typeof result !== 'undefined' && result._id) ? '지출 내역 수정' : '지출 내역 입력' %>
        </h2>

        <form id="expenseForm">
            <!-- 수정 모드일 때 ID 보관 -->
            <% if (typeof result !== 'undefined' && result._id) { %>
                <input type="hidden" id="expenseId" value="<%= result._id %>">
            <% } %>

            <!-- 1. 정기 고정비 등록 (isFixed) -->
            <div class="mb-4 d-flex align-items-center justify-content-between p-3 rounded-3 bg-white shadow-sm border border-light">
                <div>
                    <label class="form-check-label fw-bold text-dark d-block mb-1" for="isFixedExpense">
                        정기 고정비 등록
                    </label>
                    <small class="text-muted" style="font-size: 13px;">숨만 쉬어도 나가는 돈(월세, 보험료 등)인가요?</small>
                </div>

                <div class="form-check form-switch m-0 p-0 d-flex align-items-center">
                    <input class="form-check-input custom-switch" type="checkbox" role="switch" id="isFixedExpense"
                        name="isFixed" <%= (typeof activeIsFixed !== 'undefined' && activeIsFixed) ? 'checked' : '' %> >
                </div>
            </div>

            <!-- 2. 그룹/이벤트 (event) -->
            <div class="input-group mb-3">
                <label class="input-group-text" for="group">그룹/이벤트</label>
                <select class="form-select" id="group" name="event">
                    <option disabled <%= (typeof result === 'undefined' || !result.event) ? 'selected' : '' %>>선택하세요...</option>
                    <% 
                      const events = ['개인지출', '친구', '데이트', '지인', '가족', '비즈니스', '기타이벤트'];
                      const selectedEvent = (typeof result !== 'undefined' && result.event) ? result.event : '개인지출';
                      events.forEach(evt => { 
                    %>
                        <option value="<%= evt %>" <%= selectedEvent === evt ? 'selected' : '' %>>
                            <%= evt === '개인지출' ? '개인지출 (기본)' : (evt === '기타이벤트' ? '기타 이벤트' : evt) %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <!-- 3. 카테고리 (category) -->
            <div class="input-group mb-3">
                <label class="input-group-text" for="category">카테고리</label>
                <select class="form-select" id="category" name="category">
                    <option disabled <%= (typeof result === 'undefined' || !result.category) ? 'selected' : '' %>>선택하세요...</option>
                    <% 
                      const categories = ['식비', '교통비', '주거/통신', '문화/여가', '구독비', '쇼핑비', '병원비', '기타'];
                      const selectedCategory = (typeof result !== 'undefined' && result.category) ? result.category : '';
                      categories.forEach(cat => { 
                    %>
                        <option value="<%= cat %>" <%= selectedCategory === cat ? 'selected' : '' %>><%= cat %></option>
                    <% }); %>
                </select>
            </div>

            <!-- 4. 지출액 (price) -->
            <div class="input-group mb-3">
                <span class="input-group-text">지출액</span>
                <input type="number" class="form-control" id="amount" name="price" placeholder="금액을 입력하세요"
                    value="<%= (typeof result !== 'undefined' && result.price) ? result.price : '' %>" required>
                <span class="input-group-text">원</span>
            </div>

            <!-- 5. 날짜 (Flatpickr) -->
            <div class="input-group mb-3">
                <span class="input-group-text" id="dateLabel">
                    <%= (typeof result !== 'undefined' && result.isFixed) ? '시작 날짜' : '날짜' %>
                </span>
                <input type="text" id="datePicker" name="date" class="form-control bg-white" placeholder="날짜 선택" 
                    value="<%= initialDate %>" readonly required>
            </div>

            <!-- 6. 설명 (explanation) -->
            <div class="input-group mb-4">
                <span class="input-group-text">설명</span>
                <input type="text" class="form-control" id="description" name="explanation"
                    placeholder="지출 관련 메모를 적어주세요"
                    value="<%= (typeof result !== 'undefined' && result.explanation) ? result.explanation : '' %>">
            </div>

            <!-- 7. 저장 버튼 -->
            <div class="d-grid gap-2">
                <button class="btn btn-primary btn-lg" type="submit">지출 내역 저장하기</button>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // 1. Flatpickr 초기화
        const fp = flatpickr("#datePicker", {
            locale: "ko",
            dateFormat: "Y-m-d",
            defaultDate: <%- JSON.stringify(initialDate || 'today') %>,
            disableMobile: "true"
        });

        // 2. 정기 고정비 토글 스위치 텍스트 전환
        const isFixedCheckbox = document.getElementById('isFixedExpense');
        const dateLabel = document.getElementById('dateLabel');

        isFixedCheckbox.addEventListener('change', function () {
            dateLabel.textContent = this.checked ? '시작 날짜' : '날짜';
        });

        // 3. 폼 제출 처리 (비동기 POST)
        document.getElementById('expenseForm').addEventListener('submit', async (e) => {
            e.preventDefault();

            const expenseIdInput = document.getElementById('expenseId');
            const expenseId = expenseIdInput ? expenseIdInput.value : null;

            // 💡 핵심 수정: 체크 시 문자열 'on'으로 전달하도록 설정
            const isFixedVal = isFixedCheckbox.checked ? 'on' : undefined;

            const formData = {
                moneyType: 'expense',
                isFixed: isFixedVal, // 체크 시 'on' 전송
                event: document.getElementById('group').value,
                category: document.getElementById('category').value,
                price: Number(document.getElementById('amount').value),
                date: document.getElementById('datePicker').value,
                explanation: document.getElementById('description').value
            };

            const targetUrl = '/expense/post';

            try {
                const response = await fetch(targetUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(formData)
                });

                const result = await response.json();

                if (!result.success) {
                    if (result.errors) {
                        const errorMessages = Object.values(result.errors);
                        alert(errorMessages[0] || '유효성 검사에 실패했습니다.');
                    } else {
                        alert(result.message || '저장에 실패했습니다.');
                    }
                } else {
                    alert('지출 내역이 성공적으로 저장되었습니다.');
                    window.location.href = '/expense/list';
                }
            } catch (error) {
                console.error('서버 통신 에러:', error);
                alert('서버와 연결할 수 없습니다.');
            }
        });
    </script>
</body>

</html>
