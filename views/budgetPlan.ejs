<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>예산 계획 설정</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/main.css" rel="stylesheet">
    <style>
        .budget-container {
            max-width: 700px;
            margin: 0 auto;
            padding: 20px;
        }

        .budget-card {
            background-color: white;
            border-radius: 12px;
            padding: 30px;
            margin-top: 30px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
            border-left: 5px solid #ff7e36;
        }

        .budget-card h4 {
            color: #333;
            font-weight: bold;
            margin-bottom: 25px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
            display: block;
        }

        .form-control {
            padding: 10px 15px;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            font-size: 14px;
        }

        .form-control:focus {
            border-color: #ff7e36;
            box-shadow: 0 0 0 0.2rem rgba(255, 126, 54, 0.25);
        }

        .budget-display {
            background: linear-gradient(135deg, #ff7e36 0%, #ffb347 100%);
            color: white;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            text-align: center;
        }

        .budget-label {
            font-size: 13px;
            opacity: 0.9;
        }

        .budget-amount {
            font-size: 36px;
            font-weight: bold;
            margin-top: 8px;
            font-family: 'Arial', sans-serif;
        }

        .nav-tabs {
            border-bottom: 2px solid #dee2e6;
        }

        .nav-tabs .nav-link {
            color: #6c757d;
            border: none;
            font-weight: 600;
            padding: 12px 24px;
            border-bottom: 3px solid transparent;
            transition: all 0.3s ease;
        }

        .nav-tabs .nav-link:hover {
            color: #ff7e36;
            border-bottom-color: #ff7e36;
        }

        .nav-tabs .nav-link.active {
            color: #ff7e36;
            border-bottom-color: #ff7e36;
            background-color: transparent;
        }

        .btn-save {
            background-color: #ff7e36;
            border-color: #ff7e36;
            color: white;
            font-weight: 600;
            padding: 12px 24px;
            border-radius: 6px;
            width: 100%;
            transition: all 0.3s ease;
        }

        .btn-save:hover {
            background-color: #e56a1f;
            border-color: #e56a1f;
            color: white;
        }

        .alert-message {
            display: none;
            border-radius: 6px;
            margin-bottom: 20px;
            animation: slideIn 0.3s ease;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }

        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }

        .helper-text {
            font-size: 12px;
            color: #6c757d;
            margin-top: 5px;
        }

        @media (max-width: 768px) {
            .budget-card {
                padding: 20px;
            }

            .budget-amount {
                font-size: 28px;
            }

            .nav-tabs .nav-link {
                padding: 10px 16px;
                font-size: 14px;
            }
        }
    </style>
</head>
<body class="bg-light">
    <%- include('nav.ejs') %>

    <div class="budget-container">
        <h2 style="color: #333; font-weight: bold; margin-bottom: 10px;">📊 예산 계획 설정</h2>
        <p style="color: #6c757d; margin-bottom: 20px;">주간 또는 월간 예산을 설정하세요.</p>

        <div class="alert-message" id="messageBox"></div>

        <!-- 탭 네비게이션 -->
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="weekly-tab" data-bs-toggle="tab" data-bs-target="#weekly" type="button" role="tab">
                    📅 주간 예산
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="monthly-tab" data-bs-toggle="tab" data-bs-target="#monthly" type="button" role="tab">
                    📆 월간 예산
                </button>
            </li>
        </ul>

        <!-- 탭 콘텐츠 -->
        <div class="tab-content">
            <!-- 주간 예산 탭 -->
            <div class="tab-pane fade show active" id="weekly" role="tabpanel">
                <div class="budget-card">
                    <h4>주간 예산 계획</h4>

                    <!-- 기간 선택 -->
                    <div class="form-group">
                        <label>기간 선택</label>
                        <div class="d-flex gap-2 flex-wrap">
                            <input type="date" id="weeklyStartDate" class="form-control" style="flex: 1; min-width: 150px;">
                            <span class="align-self-center">~</span>
                            <input type="date" id="weeklyEndDate" class="form-control" style="flex: 1; min-width: 150px;">
                        </div>
                        <div class="helper-text">또는</div>
                        <button type="button" class="btn btn-sm btn-outline-secondary mt-2" onclick="generateWeekly()">
                            이번 주로 자동 설정
                        </button>
                    </div>

                    <!-- 예산 입력 -->
                    <div class="budget-display">
                        <div class="budget-label">이번 주 예산</div>
                        <div class="budget-amount">₩<span id="weeklyDisplay">0</span></div>
                    </div>

                    <div class="form-group">
                        <label>예산 금액 (원)</label>
                        <input type="number" id="weeklyBudget" class="form-control form-control-lg" 
                               placeholder="0" min="0" oninput="updateWeeklyDisplay()">
                        <div class="helper-text">설정하고 싶은 주간 예산을 입력하세요.</div>
                    </div>

                    <button type="button" class="btn-save" onclick="saveWeeklyBudget()">
                        저장하기
                    </button>
                </div>
            </div>

            <!-- 월간 예산 탭 -->
            <div class="tab-pane fade" id="monthly" role="tabpanel">
                <div class="budget-card">
                    <h4>월간 예산 계획</h4>

                    <!-- 기간 선택 -->
                    <div class="form-group">
                        <label>기간 선택 (연-월)</label>
                        <div class="d-flex gap-2 flex-wrap">
                            <input type="month" id="monthlyPeriod" class="form-control" style="flex: 1; min-width: 150px;">
                            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="setCurrentMonth()">
                                이번 달로 설정
                            </button>
                        </div>
                    </div>

                    <!-- 예산 입력 -->
                    <div class="budget-display">
                        <div class="budget-label">이번 달 예산</div>
                        <div class="budget-amount">₩<span id="monthlyDisplay">0</span></div>
                    </div>

                    <div class="form-group">
                        <label>예산 금액 (원)</label>
                        <input type="number" id="monthlyBudget" class="form-control form-control-lg" 
                               placeholder="0" min="0" oninput="updateMonthlyDisplay()">
                        <div class="helper-text">설정하고 싶은 월간 예산을 입력하세요.</div>
                    </div>

                    <button type="button" class="btn-save" onclick="saveMonthlyBudget()">
                        저장하기
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // 이번 주 자동 설정
        function generateWeekly() {
            const today = new Date();
            const dayOfWeek = today.getDay();
            const startDate = new Date(today);
            startDate.setDate(today.getDate() - dayOfWeek);
            
            const endDate = new Date(startDate);
            endDate.setDate(startDate.getDate() + 6);

            document.getElementById('weeklyStartDate').valueAsDate = startDate;
            document.getElementById('weeklyEndDate').valueAsDate = endDate;
        }

        // 이번 달 설정
        function setCurrentMonth() {
            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            document.getElementById('monthlyPeriod').value = `${year}-${month}`;
        }

        // 주간 예산 표시 업데이트
        function updateWeeklyDisplay() {
            const amount = parseInt(document.getElementById('weeklyBudget').value) || 0;
            document.getElementById('weeklyDisplay').textContent = amount.toLocaleString();
        }

        // 월간 예산 표시 업데이트
        function updateMonthlyDisplay() {
            const amount = parseInt(document.getElementById('monthlyBudget').value) || 0;
            document.getElementById('monthlyDisplay').textContent = amount.toLocaleString();
        }

        // 메시지 표시
        function showMessage(message, isSuccess = true) {
            const msgBox = document.getElementById('messageBox');
            msgBox.className = `alert-message ${isSuccess ? 'alert-success' : 'alert-danger'}`;
            msgBox.textContent = isSuccess ? '✓ ' + message : '✗ ' + message;
            msgBox.style.display = 'block';
            
            setTimeout(() => {
                msgBox.style.display = 'none';
            }, 3000);
        }

        // 주간 예산 저장
        async function saveWeeklyBudget() {
            const startDate = document.getElementById('weeklyStartDate').value;
            const endDate = document.getElementById('weeklyEndDate').value;
            const budget = parseInt(document.getElementById('weeklyBudget').value) || 0;

            if (!startDate || !endDate) {
                showMessage('시작일과 종료일을 모두 입력해주세요.', false);
                return;
            }

            if (budget <= 0) {
                showMessage('예산을 0보다 크게 입력해주세요.', false);
                return;
            }

            try {
                const response = await fetch('/plan/budget/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        planType: 'weekly',
                        period: `${startDate}~${endDate}`,
                        budget
                    })
                });

                const result = await response.json();

                if (result.success) {
                    showMessage('주간 예산이 저장되었습니다!', true);
                    setTimeout(() => {
                        document.getElementById('weeklyBudget').value = '';
                        updateWeeklyDisplay();
                    }, 1500);
                } else {
                    showMessage(result.message || '저장에 실패했습니다.', false);
                }
            } catch (error) {
                console.error(error);
                showMessage('서버 에러가 발생했습니다.', false);
            }
        }

        // 월간 예산 저장
        async function saveMonthlyBudget() {
            const period = document.getElementById('monthlyPeriod').value;
            const budget = parseInt(document.getElementById('monthlyBudget').value) || 0;

            if (!period) {
                showMessage('연-월을 선택해주세요.', false);
                return;
            }

            if (budget <= 0) {
                showMessage('예산을 0보다 크게 입력해주세요.', false);
                return;
            }

            try {
                const response = await fetch('/plan/budget/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        planType: 'monthly',
                        period,
                        budget
                    })
                });

                const result = await response.json();

                if (result.success) {
                    showMessage('월간 예산이 저장되었습니다!', true);
                    setTimeout(() => {
                        document.getElementById('monthlyBudget').value = '';
                        updateMonthlyDisplay();
                    }, 1500);
                } else {
                    showMessage(result.message || '저장에 실패했습니다.', false);
                }
            } catch (error) {
                console.error(error);
                showMessage('서버 에러가 발생했습니다.', false);
            }
        }

        // 초기화
        document.addEventListener('DOMContentLoaded', function() {
            setCurrentMonth();
        });
    </script>
</body>
</html>
