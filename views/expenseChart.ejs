<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>가계부 홈</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/main.css" rel="stylesheet">
</head>

<body class="bg-light">

  <!-- 상단 바 불러오기 -->
  <%- include('nav.ejs') %>
    <div class="container custom-container main-content mx-auto">
      <h3 class="fw-bold mb-4 text-dark">📊 지출 분석 리포트</h3>

      <div class="row g-4">
        <!-- 1. 그룹/이벤트별 지출 (원형 그래프) -->
        <div class="col-md-6">
          <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-4">
              <h5 class="card-title fw-bold text-secondary mb-3">그룹/이벤트별 지출</h5>
              <div class="chart-container">
                <canvas id="eventChart"></canvas>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. 카테고리별 지출 (원형 그래프) -->
        <div class="col-md-6">
          <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body p-4">
              <h5 class="card-title fw-bold text-secondary mb-3">카테고리별 지출</h5>
              <div class="chart-container">
                <canvas id="categoryChart"></canvas>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. 고정비 vs 변동비 비교 (막대 그래프) -->
        <div class="col-12">
          <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
              <h5 class="card-title fw-bold text-secondary mb-3">고정비 vs 변동비 비율</h5>
              <div class="chart-container-bar">
                <canvas id="fixedChart"></canvas>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Chart.js CDN 불러오기 -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
      /* 차트가 깨지지 않고 비율을 유지하도록 컨테이너 크기 조절 */
      .chart-container {
        position: relative;
        margin: auto;
        height: 280px;
        width: 100%;
      }

      .chart-container-bar {
        position: relative;
        margin: auto;
        height: 300px;
        width: 100%;
      }
    </style>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
      const data = <%- JSON.stringify(chartData) %>;

      // 공통 툴팁 퍼센트 계산 함수
      const getPieTooltipCallback = function(context) {
        const label = context.label || '';
        const value = context.raw;
        
        // 전체 합계 계산
        const total = context.dataset.data.reduce((sum, val) => sum + val, 0);
        
        // 데이터가 모두 0인 경우 예외 처리
        if (total === 0) return `${label}: 0원 (0%)`;
        
        const percentage = ((value / total) * 100).toFixed(1);
        
        // 출력 형태: "식비: 50,000원 (35.3%)"
        return ` ${label}: ${value.toLocaleString()}원 (${percentage}%)`;
      };

      // 1. 그룹/이벤트별 차트 (Doughnut - 도넛 원형)
      const ctxEvent = document.getElementById('eventChart').getContext('2d');
      new Chart(ctxEvent, {
        type: 'doughnut',
        data: {
          labels: data.eventLabel,
          datasets: [{
            data: data.eventData,
            backgroundColor: [
              '#0d6efd', '#6c757d', '#198754', '#dc3545', '#ffc107', '#0dcaf0', '#6f42c1'
            ],
            borderWidth: 3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' },
            tooltip: {
              callbacks: {
                label: getPieTooltipCallback // 퍼센트 툴팁 적용
              }
            }
          }
        }
      });

      // 2. 카테고리별 차트 (Pie - 꽉 찬 원형)
      const ctxCategory = document.getElementById('categoryChart').getContext('2d');
      new Chart(ctxCategory, {
        type: 'pie',
        data: {
          labels: data.categoryLabel,
          datasets: [{
            data: data.categoryData,
            backgroundColor: [
              '#20c997', '#ffc107', '#d63384', '#0dcaf0', '#6f42c1', '#fd7e14', '#198754', '#6c757d'
            ],
            borderWidth: 3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' },
            tooltip: {
              callbacks: {
                label: getPieTooltipCallback // 퍼센트 툴팁 적용
              }
            }
          }
        }
      });

      // 3. 고정비 vs 변동비 비교 차트 (Bar)
      const ctxFixed = document.getElementById('fixedChart').getContext('2d');
      new Chart(ctxFixed, {
        type: 'bar',
        data: {
          labels: ['정기 고정비', '일반 변동비'],
          datasets: [{
            label: '지출 금액 (원)',
            data: data.fixData,
            backgroundColor: [
              'rgba(13, 110, 253, 0.75)',
              'rgba(108, 117, 125, 0.75)'
            ],
            borderColor: ['#0d6efd', '#6c757d'],
            borderWidth: 1,
            borderRadius: 8
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            y: {
              beginAtZero: true,
              ticks: {
                callback: function (value) { return value.toLocaleString() + '원'; }
              }
            }
          },
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function(context) {
                  const label = context.dataset.label || '';
                  const value = context.raw;
                  return ` ${label}: ${value.toLocaleString()}원`; 
                }
              }
            }
          }
        }
      });
    </script>
</body>

</html>