<!DOCTYPE html>
<html lang="ko">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>나의 가계부 목록</title>
  <!-- 💡 부트스트랩 5 CDN 링크 추가 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/main.css" rel="stylesheet">
  <script src="https://kit.fontawesome.com/3cda4bc1c7.js" crossorigin="anonymous"></script>
  <style>
    .action-buttons {
      min-width: 96px;
    }

    .action-buttons .action-icon {
      opacity: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      color: #6c757d;
      background: transparent;
      border: 1px solid transparent;
      transition: opacity 0.15s ease-in-out, background-color 0.15s ease-in-out, color 0.15s ease-in-out, border-color 0.15s ease-in-out;
      text-decoration: none;
    }

    tr:hover .action-buttons .action-icon {
      opacity: 1;
    }

    .action-buttons .action-icon:hover {
      color: #0d6efd;
      background: rgba(13, 110, 253, 0.1);
      border-color: rgba(13, 110, 253, 0.2);
    }

    .action-buttons .action-icon.delete-icon:hover {
      color: #dc3545;
      background: rgba(220, 53, 69, 0.1);
      border-color: rgba(220, 53, 69, 0.2);
    }
  </style>
</head>

<body class="bg-light">
  <%- include('nav.ejs') %>
    <%
      const today = new Date();
      const defaultMonth = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}`;
      const currentSelectedMonth = typeof selectedMonth !== 'undefined' ? selectedMonth : defaultMonth;
      const [currentSelectedYear, currentSelectedMonthNumber] = currentSelectedMonth.split('-');
    %>
    <div class="container my-5" style="max-width: 900px;">
      <!-- 헤더 구역 -->
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-dark fw-bold">💰 가계부 지출 내역</h1>
        <a href="/expense/write" class="btn btn-primary fw-semibold shadow-sm"><i class="fa-solid fa-circle-plus"></i> 새
          지출 내역</a>
      </div>

      <!-- 월별 조회 -->
      <div class="card border-0 shadow-sm mb-4">
        <div id="month-navigator" class="card-body p-3 bg-white rounded d-flex align-items-center justify-content-between"
          data-selected-month="<%= currentSelectedMonth %>">
          <button type="button" id="previous-month" class="btn btn-outline-secondary border-0" aria-label="이전 달">
            <i class="fa-solid fa-chevron-left"></i>
            <span class="d-none d-sm-inline ms-1">이전 달</span>
          </button>
          <strong class="fs-5 text-dark">
            <%= currentSelectedYear %>년 <%= Number(currentSelectedMonthNumber) %>월
          </strong>
          <button type="button" id="next-month" class="btn btn-outline-secondary border-0" aria-label="다음 달">
            <span class="d-none d-sm-inline me-1">다음 달</span>
            <i class="fa-solid fa-chevron-right"></i>
          </button>
        </div>
      </div>

      <!-- 총합계 요약 카드 구역 -->
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 bg-white rounded">
          <span id="expense-total-label" class="text-secondary small fw-medium text-uppercase tracking-wider">
            <% if (currentSelectedMonth) { %>
              <%= currentSelectedMonth.replace('-', '년 ') %>월 지출 금액
            <% } else { %>
              총 누적 지출 금액
            <% } %>
          </span>
          <div class="display-6 text-danger fw-bold mt-1">
            <span id="expense-total" class="fs-4 fw-normal text-dark">
              <%= total.toLocaleString() %>원
            </span>
          </div>
        </div>
      </div>

      <!-- 데이터 테이블 카드 -->
      <div class="card border-0 shadow-sm overflow-hidden">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-dark text-uppercase fs-7">
              <tr>
                <th scope="col" class="ps-4">날짜</th>
                <th scope="col">분류</th>
                <th scope="col">내역</th>
                <th scope="col">금액</th>
                <th scope="col" class="pe-4">상세 설명</th>
                <th scope="col" class="text-end"></th>
              </tr>
            </thead>
            <tbody>
              <% if (items.length===0) { %>
                <tr>
                  <td colspan="6" class="text-center py-5 text-secondary">
                    <% if (currentSelectedMonth) { %>
                      선택한 월에 기록된 지출 내역이 없습니다.
                    <% } else { %>
                      기록된 지출 내역이 없습니다. 새로운 지출을 등록해 보세요!
                    <% } %>
                  </td>
                </tr>
                <% } else { %>
                  <% items.forEach(function(item) { %>
                    <tr>
                      <td class="ps-4 text-secondary small">

                      <%= item.date %>
                      </td>
                      <td>
                        <!-- 카테고리별로 이쁘게 배지(Badge) 처리 -->
                        <span
                          class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle rounded-pill px-3">
                          <%= item.category %>
                        </span>
                      </td>
                      <td><span class="fw-semibold text-dark">
                          <%= item.event %>
                        </span></td>
                      <td class="text-danger fw-semibold">
                        <%= item.price.toLocaleString() %>원
                      </td>
                      <td class="text-dark pe-4 small text-truncate" style="max-width: 200px;">
                        <%= item.explanation %>
                      </td>
                      <td class="text-end pe-4 action-buttons">
                        <a href="/expense/edit/<%= item._id %>" class="action-icon edit-icon" title="수정">
                          <i class="fa-solid fa-pen-to-square"></i>
                        </a>
                        <a href="#" class="action-icon delete-icon" title="삭제"
                          onclick="deleteExpense('<%= item._id %>', event)">
                          <i class="fa-solid fa-trash"></i>
                        </a>
                      </td>
                    </tr>
                    <% }); %>
                      <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <script>
      const monthNavigator = document.getElementById('month-navigator');
      const previousMonthButton = document.getElementById('previous-month');
      const nextMonthButton = document.getElementById('next-month');
      const selectedMonth = monthNavigator.dataset.selectedMonth;

      function moveMonth(month, amount) {
        const [year, monthNumber] = month.split('-').map(Number);
        const movedDate = new Date(year, monthNumber - 1 + amount, 1);

        return [
          movedDate.getFullYear(),
          String(movedDate.getMonth() + 1).padStart(2, '0')
        ].join('-');
      }

      function moveToMonth(month) {
        window.location.href = `/expense/list?month=${encodeURIComponent(month)}`;
      }

      previousMonthButton.addEventListener('click', () => {
        moveToMonth(moveMonth(selectedMonth, -1));
      });

      nextMonthButton.addEventListener('click', () => {
        moveToMonth(moveMonth(selectedMonth, 1));
      });

      async function deleteExpense(id, event) {
        // 1. <a> 태그의 기본 페이지 이동 방지
        event.preventDefault();

        // 2. 실수 방지를 위한 삭제 확인
        if (!confirm('정말 삭제하시겠습니까?')) {
          return;
        }

        try {
          // 3. 백엔드로 DELETE 요청 전송
          const response = await fetch(`/expense/delete/${id}`, {
            method: 'DELETE',
            headers: {
              'Content-Type': 'application/json'
            }
          });

          const result = await response.json();

          if (result.success) {
            alert('삭제되었습니다.');
            // 삭제 성공 시 목록 새로고침 (또는 리다이렉트)
            window.location.reload();
          } else {
            alert(result.message || '삭제 처리에 실패했습니다.');
          }
        } catch (error) {
          console.error('삭제 요청 중 에러 발생:', error);
          alert('서버와 통신하는 중 오류가 발생했습니다.');
        }
      }
    </script>
    <!-- 💡 부트스트랩 자바스크립트 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>
