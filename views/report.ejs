<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>정기 리포트</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="/main.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        :root {
            --primary-blue: #1e40af;
            --light-blue: #3b82f6;
            --lighter-blue: #dbeafe;
            --very-light-blue: #f0f9ff;
        }

        .report-container {
            max-width: 1000px;
            margin: 0 auto;
            padding: 20px;
        }

        .page-header {
            margin-bottom: 30px;
        }

        .page-header h2 {
            color: var(--primary-blue);
            font-weight: bold;
            margin-bottom: 5px;
        }

        .page-header p {
            color: #6c757d;
            margin: 0;
        }

        .nav-tabs {
            border-bottom: 2px solid #dee2e6;
            margin-bottom: 30px;
        }

        .nav-tabs .nav-link {
            color: #6c757d;
            border: none;
            font-weight: 600;
            padding: 12px 24px;
            border-bottom: 3px solid transparent;
            transition: all 0.3s ease;
        }

        .nav-tabs .nav-link:hover {
            color: var(--light-blue);
            border-bottom-color: var(--light-blue);
        }

        .nav-tabs .nav-link.active {
            color: var(--primary-blue);
            border-bottom-color: var(--primary-blue);
            background-color: transparent;
        }

        .report-section {
            background: white;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 25px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            border-top: 4px solid var(--primary-blue);
        }

        .report-section h4 {
            color: var(--primary-blue);
            font-weight: bold;
            margin-bottom: 20px;
            font-size: 18px;
        }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: linear-gradient(135deg, var(--very-light-blue) 0%, var(--lighter-blue) 100%);
            padding: 20px;
            border-radius: 8px;
            border-left: 4px solid var(--light-blue);
        }

        .stat-label {
            color: #6c757d;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .stat-value {
            color: var(--primary-blue);
            font-size: 28px;
            font-weight: bold;
            font-family: 'Arial', sans-serif;
        }

        .stat-unit {
            color: #6c757d;
            font-size: 13px;
            font-weight: 600;
            margin-left: 5px;
        }

        .category-breakdown {
            margin-top: 25px;
        }

        .category-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #e9ecef;
        }

        .category-item:last-child {
            border-bottom: none;
        }

        .category-name {
            color: #333;
            font-weight: 600;
        }

        .category-bar {
            flex: 1;
            margin: 0 15px;
            height: 6px;
            background-color: #e9ecef;
            border-radius: 3px;
            overflow: hidden;
        }

        .category-bar-fill {
            height: 100%;
            background: linear-gradient(90deg, var(--light-blue), var(--primary-blue));
            border-radius: 3px;
        }

        .category-amount {
            color: var(--primary-blue);
            font-weight: bold;
            min-width: 100px;
            text-align: right;
        }

        .highlight-box {
            background-color: var(--very-light-blue);
            border-left: 4px solid var(--light-blue);
            padding: 15px;
            border-radius: 6px;
            margin-top: 15px;
            color: #1e40af;
            font-size: 14px;
            line-height: 1.6;
        }

        .chart-container {
            position: relative;
            height: 300px;
            margin: 20px 0;
        }

        .comparison-table {
            width: 100%;
            margin-top: 15px;
        }

        .comparison-table th {
            background-color: var(--very-light-blue);
            color: var(--primary-blue);
            border: none;
            font-weight: 600;
            padding: 12px;
        }

        .comparison-table td {
            padding: 12px;
            border-bottom: 1px solid #e9ecef;
        }

        .comparison-table tr:last-child td {
            border-bottom: none;
        }

        .badge-positive {
            background-color: #d1fae5;
            color: #065f46;
        }

        .badge-negative {
            background-color: #fee2e2;
            color: #991b1b;
        }

        .empty-state {
            text-align: center;
            padding: 40px 20px;
            color: #6c757d;
        }

        @media (max-width: 768px) {
            .stat-grid {
                grid-template-columns: 1fr;
            }

            .report-section {
                padding: 15px;
            }

            .stat-value {
                font-size: 24px;
            }

            .category-item {
                flex-wrap: wrap;
            }

            .category-bar {
                width: 100%;
                margin: 10px 0;
            }

            .nav-tabs .nav-link {
                padding: 10px 16px;
                font-size: 14px;
            }
        }
    </style>
</head>
<body class="bg-light">
    <%- include('nav.ejs') %>

    <div class="report-container">
        <div class="page-header">
            <h2>📊 정기 리포트</h2>
            <p>월간 및 주간 지출 현황을 한눈에 확인하세요</p>
        </div>

        <!-- 탭 네비게이션 -->
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="monthly-tab" data-bs-toggle="tab" data-bs-target="#monthly" type="button" role="tab">
                    📆 월간 리포트
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="weekly-tab" data-bs-toggle="tab" data-bs-target="#weekly" type="button" role="tab">
                    📅 주간 리포트
                </button>
            </li>
        </ul>

        <!-- 탭 콘텐츠 -->
        <div class="tab-content">
            <!-- 월간 리포트 -->
            <div class="tab-pane fade show active" id="monthly" role="tabpanel">
                <!-- 월간 통계 -->
                <div class="report-section">
                    <h4>2026년 7월 지출 현황</h4>
                    
                    <div class="stat-grid">
                        <div class="stat-card">
                            <div class="stat-label">총 지출</div>
                            <div>
                                <span class="stat-value">2,850</span>
                                <span class="stat-unit">원</span>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">예산</div>
                            <div>
                                <span class="stat-value">3,000</span>
                                <span class="stat-unit">원</span>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">절약액</div>
                            <div>
                                <span class="stat-value" style="color: #10b981;">150</span>
                                <span class="stat-unit">원</span>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">진행률</div>
                            <div>
                                <span class="stat-value">95%</span>
                            </div>
                        </div>
                    </div>

                    <div class="highlight-box">
                        ✅ 지난달(6월)보다 12% 지출이 감소했습니다. 좋은 소비 습관을 유지해주세요!
                    </div>
                </div>

                <!-- 카테고리별 분석 -->
                <div class="report-section">
                    <h4>카테고리별 지출 분석</h4>
                    
                    <div class="category-breakdown">
                        <div class="category-item">
                            <span class="category-name">🍽️ 식비</span>
                            <div class="category-bar">
                                <div class="category-bar-fill" style="width: 35%;"></div>
                            </div>
                            <span class="category-amount">1,000원</span>
                        </div>
                        <div class="category-item">
                            <span class="category-name">🚗 교통비</span>
                            <div class="category-bar">
                                <div class="category-bar-fill" style="width: 15%;"></div>
                            </div>
                            <span class="category-amount">43원</span>
                        </div>
                        <div class="category-item">
                            <span class="category-name">🏠 주거/통신</span>
                            <div class="category-bar">
                                <div class="category-bar-fill" style="width: 20%;"></div>
                            </div>
                            <span class="category-amount">570원</span>
                        </div>
                        <div class="category-item">
                            <span class="category-name">🎬 문화/여가</span>
                            <div class="category-bar">
                                <div class="category-bar-fill" style="width: 18%;"></div>
                            </div>
                            <span class="category-amount">515원</span>
                        </div>
                        <div class="category-item">
                            <span class="category-name">🛒 쇼핑비</span>
                            <div class="category-bar">
                                <div class="category-bar-fill" style="width: 8%;"></div>
                            </div>
                            <span class="category-amount">230원</span>
                        </div>
                        <div class="category-item">
                            <span class="category-name">🏥 기타</span>
                            <div class="category-bar">
                                <div class="category-bar-fill" style="width: 4%;"></div>
                            </div>
                            <span class="category-amount">105원</span>
                        </div>
                    </div>
                </div>

                <!-- 월별 비교 -->
                <div class="report-section">
                    <h4>최근 3개월 비교</h4>
                    
                    <table class="comparison-table">
                        <thead>
                            <tr>
                                <th>월</th>
                                <th>지출액</th>
                                <th>예산</th>
                                <th>상태</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>2026년 5월</td>
                                <td>3,200원</td>
                                <td>3,000원</td>
                                <td><span class="badge badge-negative">초과 200</span></td>
                            </tr>
                            <tr>
                                <td>2026년 6월</td>
                                <td>3,240원</td>
                                <td>3,100원</td>
                                <td><span class="badge badge-negative">초과 140</span></td>
                            </tr>
                            <tr>
                                <td>2026년 7월</td>
                                <td>2,850원</td>
                                <td>3,000원</td>
                                <td><span class="badge badge-positive">절약 150</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 주간 리포트 -->
            <div class="tab-pane fade" id="weekly" role="tabpanel">
                <!-- 주간 통계 -->
                <div class="report-section">
                    <h4>2026년 7월 23일 주 지출 현황</h4>
                    
                    <div class="stat-grid">
                        <div class="stat-card">
                            <div class="stat-label">이번 주 지출</div>
                            <div>
                                <span class="stat-value">680</span>
                                <span class="stat-unit">원</span>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">주간 예산</div>
                            <div>
                                <span class="stat-value">700</span>
                                <span class="stat-unit">원</span>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">남은 예산</div>
                            <div>
                                <span class="stat-value" style="color: #10b981;">20</span>
                                <span class="stat-unit">원</span>
                            </div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-label">진행률</div>
                            <div>
                                <span class="stat-value">97%</span>
                            </div>
                        </div>
                    </div>

                    <div class="highlight-box">
                        ⚠️ 이번 주 예산 소진도가 높습니다. 남은 기간 동안 신중한 지출을 부탁드립니다.
                    </div>
                </div>

                <!-- 요일별 분석 -->
                <div class="report-section">
                    <h4>요일별 지출 현황</h4>
                    
                    <div class="category-breakdown">
                        <div class="category-item">
                            <span class="category-name">월요일 (7/21)</span>
                            <div class="category-bar">
                                <div class="category-bar-fill" style="width: 20%;"></div>
                            </div>
                            <span class="category-amount">136원</span>
                        </div>
                        <div class="category-item">
                            <span class="category-name">화요일 (7/22)</span>
                            <div class="category-bar">
                                <div class="category-bar-fill" style="width: 18%;"></div>
                            </div>
                            <span class="category-amount">122원</span>
                        </div>
                        <div class="category-item">
                            <span class="category-name">수요일 (7/23)</span>
                            <div class="category-bar">
                                <div class="category-bar-fill" style="width: 25%;"></div>
                            </div>
                            <span class="category-amount">170원</span>
                        </div>
                        <div class="category-item">
                            <span class="category-name">목요일 (7/24)</span>
                            <div class="category-bar">
                                <div class="category-bar-fill" style="width: 12%;"></div>
                            </div>
                            <span class="category-amount">82원</span>
                        </div>
                        <div class="category-item">
                            <span class="category-name">금요일 (7/25)</span>
                            <div class="category-bar">
                                <div class="category-bar-fill" style="width: 15%;"></div>
                            </div>
                            <span class="category-amount">102원</span>
                        </div>
                        <div class="category-item">
                            <span class="category-name">토요일 (7/26)</span>
                            <div class="category-bar">
                                <div class="category-bar-fill" style="width: 8%;"></div>
                            </div>
                            <span class="category-amount">54원</span>
                        </div>
                        <div class="category-item">
                            <span class="category-name">일요일 (7/27)</span>
                            <div class="category-bar">
                                <div class="category-bar-fill" style="width: 2%;"></div>
                            </div>
                            <span class="category-amount">14원</span>
                        </div>
                    </div>
                </div>

                <!-- 주간 카테고리 분석 -->
                <div class="report-section">
                    <h4>이번 주 카테고리별 지출</h4>
                    
                    <table class="comparison-table">
                        <thead>
                            <tr>
                                <th>카테고리</th>
                                <th>지출액</th>
                                <th>비율</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>🍽️ 식비</td>
                                <td>238원</td>
                                <td>35%</td>
                            </tr>
                            <tr>
                                <td>🚗 교통비</td>
                                <td>102원</td>
                                <td>15%</td>
                            </tr>
                            <tr>
                                <td>🏠 주거/통신</td>
                                <td>150원</td>
                                <td>22%</td>
                            </tr>
                            <tr>
                                <td>🎬 문화/여가</td>
                                <td>136원</td>
                                <td>20%</td>
                            </tr>
                            <tr>
                                <td>🛒 쇼핑비</td>
                                <td>34원</td>
                                <td>5%</td>
                            </tr>
                            <tr>
                                <td>🏥 기타</td>
                                <td>20원</td>
                                <td>3%</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>